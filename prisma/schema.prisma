generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int           @id @default(autoincrement())
  username    String        @unique
  email       String        @unique
  password    String
  birthday    DateTime?
  memberships GroupMember[] @relation("UserGroups")
  events      UserEvent[]
}

model Event {
  id        Int         @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime
  privacy   String
  groupId   Int?
  group     Group?      @relation("GroupEvents", fields: [groupId], references: [id])
  users     UserEvent[]
}

model UserEvent {
  id            Int     @id @default(autoincrement())
  userId        Int
  eventId       Int
  showOnProfile Boolean @default(true)
  event         Event   @relation(fields: [eventId], references: [id])
  user          User    @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
}

model Group {
  id      Int           @id @default(autoincrement())
  name    String
  privacy String
  color   String        @default("#3B82F6")
  events  Event[]       @relation("GroupEvents")
  members GroupMember[]
}

model GroupMember {
  id      Int   @id @default(autoincrement())
  groupId Int
  userId  Int
  group   Group @relation(fields: [groupId], references: [id])
  user    User  @relation("UserGroups", fields: [userId], references: [id])

  @@unique([groupId, userId])
}
